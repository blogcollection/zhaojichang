---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import SEO from '../components/SEO.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  type?: 'website' | 'article';
  publishDate?: string;
  author?: string;
  schema?: any;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  type = 'website',
  publishDate,
  author,
  schema,
  noindex = false
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <SEO
      title={title}
      description={description}
      canonical={canonical}
      type={type}
      publishDate={publishDate}
      author={author}
      schema={schema}
      noindex={noindex}
    />
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 text-slate-900 selection:bg-sky-500 selection:text-white antialiased">
    <Header />

    <main class="flex-1">
      <slot />
    </main>

    <Footer />
    <SearchModal />
  </body>
</html>
