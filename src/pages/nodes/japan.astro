---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AirportCard from '../../components/AirportCard.astro';
import { getAirportsByRegion } from '../../data/airports';
import { getArticles } from '../../data/articles';

const matchedAirports = getAirportsByRegion('日本');
const relatedArticles = getArticles().filter(a => a.slug.includes('node-regions') || a.slug.includes('chatgpt') || a.slug.includes('gaming'));
---

<Layout
  title="日本节点机场整理｜日服游戏/动漫追番/ChatGPT访问专线 - 找机场"
  description="日本节点机场专区：整理覆盖东京、大阪等日本专线与直连节点的机场，支持日服游戏、DMM、ABEMA、Netflix日区及 ChatGPT 访问。"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <Breadcrumbs
      items={[
        { label: '节点地区', href: '/airports/' },
        { label: '日本节点' },
      ]}
    />

    <div class="bg-white rounded-2xl border border-slate-200/90 p-6 sm:p-8 mb-8">
      <div class="inline-flex items-center gap-1.5 text-xs font-semibold text-sky-600 uppercase tracking-wider mb-2">
        <span class="w-2 h-2 rounded-full bg-sky-600"></span>
        核心节点地区 ｜ 日本 (Japan)
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mb-3">
        日本节点机场整理与线路指南
      </h1>
      <p class="text-sm text-slate-600 max-w-4xl leading-relaxed">
        日本节点兼具<strong>较近的物理距离</strong>与<strong>广泛的国际服务兼容性</strong>，是二次元动漫追番、日服游戏联机及 ChatGPT 访问的常见选择。
      </p>

      <div class="mt-4 pt-4 border-t border-slate-100 flex items-center gap-2 flex-wrap text-xs text-slate-500">
        <span class="font-semibold text-slate-700">日本节点特性：</span>
        <span class="badge-tag badge-brand">东亚低延迟</span>
        <span class="badge-tag badge-amber">支持 ChatGPT</span>
        <span class="badge-tag badge-green">日区流媒体覆盖</span>
      </div>
    </div>

    <div class="mb-12">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-lg font-bold text-slate-900">
          包含高品质日本节点的机场（共 {matchedAirports.length} 家）
        </h2>
        <a href="/airports/?region=日本" class="text-xs font-semibold text-sky-600 hover:underline">
          去机场大全高级筛选 →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {matchedAirports.map((airport) => (
          <AirportCard airport={airport} />
        ))}
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2 space-y-6">
        <div class="bg-white rounded-2xl border border-slate-200/90 p-6 shadow-sm">
          <h2 class="text-base font-bold text-slate-900 mb-3 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-sky-600"></span>
            日本节点选购与使用技巧
          </h2>
          <div class="space-y-3 text-xs text-slate-600 leading-relaxed">
            <p><strong>1. 二次元与流媒体首选</strong>：支持 ABEMA、TVer、DMM、pixiv 以及 Netflix 日本区动漫资源。</p>
            <p><strong>2. 低延迟 AI 体验</strong>：相比美国节点 150ms 延迟，日本节点 50ms 延迟能带来更迅捷的 ChatGPT 会话响应。</p>
          </div>
        </div>
      </div>

      <div class="space-y-6">
        <div class="bg-white rounded-2xl border border-slate-200/90 p-5 shadow-sm">
          <h3 class="text-sm font-bold text-slate-900 mb-3 flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-sky-600"></span>
            相关节点教程
          </h3>
          <div class="space-y-3">
            {relatedArticles.map((art) => (
              <a href={`/blog/${art.slug}/`} class="block group">
                <p class="text-xs font-bold text-slate-800 group-hover:text-sky-600 transition leading-snug">
                  {art.title}
                </p>
                <span class="text-[11px] text-slate-400 mt-0.5 inline-block">{art.readTime}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
