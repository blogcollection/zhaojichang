---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AirportCard from '../components/AirportCard.astro';
import { getAirports } from '../data/airports';
import { getArticles } from '../data/articles';

const airports = getAirports();
const articles = getArticles();
---

<Layout
  title="全局搜索｜机场与指南查询 - 找机场"
  description="快速搜索找机场数据库：支持按机场名称、别名、节点地区、协议、流媒体与 AI 解锁及配置教程关键词进行实时检索。"
  noindex={true}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <Breadcrumbs items={[{ label: '搜索' }]} />

    <div class="bg-white rounded-2xl border border-slate-200/90 p-6 sm:p-8 mb-8">
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mb-4">
        找机场全局搜索
      </h1>

      <div class="relative max-w-3xl">
        <input
          type="text"
          id="page-search-input"
          placeholder="输入机场名称、地区（香港/日本/新加坡）、协议（Clash/VLESS）或用途（ChatGPT/Netflix）..."
          class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-sky-500 focus:bg-white text-sm"
        />
      </div>

      <div class="mt-4 flex items-center gap-2 flex-wrap text-xs text-slate-500">
        <span>热门搜索词：</span>
        <button class="page-quick-tag px-2 py-0.5 rounded bg-slate-100 hover:bg-sky-50 hover:text-sky-600 transition" data-val="便宜机场">便宜机场</button>
        <button class="page-quick-tag px-2 py-0.5 rounded bg-slate-100 hover:bg-sky-50 hover:text-sky-600 transition" data-val="ChatGPT">ChatGPT</button>
        <button class="page-quick-tag px-2 py-0.5 rounded bg-slate-100 hover:bg-sky-50 hover:text-sky-600 transition" data-val="香港节点">香港节点</button>
        <button class="page-quick-tag px-2 py-0.5 rounded bg-slate-100 hover:bg-sky-50 hover:text-sky-600 transition" data-val="Clash">Clash</button>
        <button class="page-quick-tag px-2 py-0.5 rounded bg-slate-100 hover:bg-sky-50 hover:text-sky-600 transition" data-val="Shadowrocket">小火箭</button>
      </div>
    </div>

    <!-- Live Results Section -->
    <div id="search-page-results" class="space-y-10">
      <!-- Airports Section -->
      <div>
        <h2 class="text-lg font-bold text-slate-900 mb-4 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-sky-600"></span>
          匹配的机场服务商 (<span id="matched-airports-count">{airports.length}</span>)
        </h2>
        <div id="search-airports-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {airports.map((airport) => (
            <div
              class="search-airport-item"
              data-text={`${airport.name} ${airport.aliases} ${airport.summary} ${airport.regions.join(' ')} ${airport.nodeRegionsRaw} ${airport.protocols} ${airport.aiServices.join(' ')} ${airport.streamingServices.join(' ')} ${airport.clients.join(' ')}`.toLowerCase()}
            >
              <AirportCard airport={airport} />
            </div>
          ))}
        </div>
      </div>

      <!-- Articles Section -->
      <div>
        <h2 class="text-lg font-bold text-slate-900 mb-4 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
          匹配的使用教程与指南 (<span id="matched-articles-count">{articles.length}</span>)
        </h2>
        <div id="search-articles-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {articles.map((art) => (
            <article
              class="search-article-item bg-white rounded-xl border border-slate-200 p-5 flex flex-col justify-between hover:border-sky-300 hover:shadow-sm transition"
              data-text={`${art.title} ${art.description} ${art.keywords.join(' ')} ${art.categoryLabel}`.toLowerCase()}
            >
              <div>
                <span class="badge-tag badge-brand text-[11px] mb-2">{art.categoryLabel}</span>
                <h3 class="text-sm font-bold text-slate-900 hover:text-sky-600 transition mb-2">
                  <a href={`/blog/${art.slug}/`}>{art.title}</a>
                </h3>
                <p class="text-xs text-slate-600 line-clamp-2">{art.description}</p>
              </div>
              <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-400 mt-3">
                <span>{art.publishDate}</span>
                <a href={`/blog/${art.slug}/`} class="text-sky-600 font-semibold hover:underline">阅读 →</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  function initPageSearch() {
    const input = document.getElementById('page-search-input') as HTMLInputElement | null;
    const airportItems = Array.from(document.querySelectorAll('.search-airport-item')) as HTMLElement[];
    const articleItems = Array.from(document.querySelectorAll('.search-article-item')) as HTMLElement[];
    const airportsCount = document.getElementById('matched-airports-count');
    const articlesCount = document.getElementById('matched-articles-count');

    function performSearch(q: string) {
      const query = q.trim().toLowerCase();
      let matchAirports = 0;
      let matchArticles = 0;

      airportItems.forEach(item => {
        const text = item.dataset.text || '';
        if (!query || text.includes(query)) {
          item.style.display = '';
          matchAirports++;
        } else {
          item.style.display = 'none';
        }
      });

      articleItems.forEach(item => {
        const text = item.dataset.text || '';
        if (!query || text.includes(query)) {
          item.style.display = '';
          matchArticles++;
        } else {
          item.style.display = 'none';
        }
      });

      if (airportsCount) airportsCount.textContent = matchAirports.toString();
      if (articlesCount) articlesCount.textContent = matchArticles.toString();
    }

    if (input) {
      const urlParams = new URLSearchParams(window.location.search);
      const initialQ = urlParams.get('q') || '';
      if (initialQ) {
        input.value = initialQ;
        performSearch(initialQ);
      }

      input.addEventListener('input', (e) => {
        performSearch((e.target as HTMLInputElement).value);
      });
    }

    document.querySelectorAll('.page-quick-tag').forEach(tag => {
      tag.addEventListener('click', () => {
        const val = (tag as HTMLElement).dataset.val || '';
        if (input) {
          input.value = val;
          performSearch(val);
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initPageSearch);
</script>
