---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getArticles } from '../../data/articles';

const allArticles = getArticles();
---

<Layout
  title="找机场博客｜科学上网选购指南与客户端配置教程 - 找机场"
  description="找机场官方博客与使用知识库：收录 24 篇高质量深度指南。涵盖机场推荐、梯子推荐、价格资费分析、Clash/小火箭教程、ChatGPT/Netflix解锁、节点地区对比与防跑路策略。"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <Breadcrumbs items={[{ label: '教程与指南' }]} />

    <!-- Header Banner -->
    <div class="bg-white rounded-2xl border border-slate-200/90 p-6 sm:p-8 mb-8">
      <div class="inline-flex items-center gap-1.5 text-xs font-semibold text-sky-600 uppercase tracking-wider mb-2">
        <span class="w-2 h-2 rounded-full bg-sky-600"></span>
        使用指南与知识库
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mb-3">
        找机场教程与指南
      </h1>
      <p class="text-sm text-slate-600 max-w-4xl leading-relaxed">
        找机场博客整理机场推荐、梯子推荐、科学上网基础知识、机场价格与线路分析，以及 Clash、Shadowrocket、sing-box 等客户端配置教程。
      </p>

      <!-- 热门专题 -->
      <div class="mt-6 pt-5 border-t border-slate-100">
        <div class="text-xs font-bold text-slate-800 uppercase tracking-wider mb-3 flex items-center gap-1.5">
          <svg class="w-4 h-4 text-sky-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          热门专题
        </div>
        <div class="flex items-center gap-2.5 flex-wrap text-xs">
          <a
            href="/blog/airport-recommendations/"
            class="px-3 py-1.5 rounded-lg bg-sky-50 text-sky-700 font-semibold border border-sky-200 hover:bg-sky-100 hover:border-sky-300 transition flex items-center gap-1.5 shadow-sm"
          >
            <span>🎯 机场推荐</span>
          </a>
          <a
            href="/blog/tizi-recommendations/"
            class="px-3 py-1.5 rounded-lg bg-indigo-50 text-indigo-700 font-semibold border border-indigo-200 hover:bg-indigo-100 hover:border-indigo-300 transition flex items-center gap-1.5 shadow-sm"
          >
            <span>🚀 梯子推荐</span>
          </a>
          <a
            href="/cheap-airports/"
            class="px-3 py-1.5 rounded-lg bg-slate-50 text-slate-700 font-medium border border-slate-200 hover:bg-slate-100 transition"
          >
            💰 便宜机场
          </a>
          <a
            href="/monthly-airports/"
            class="px-3 py-1.5 rounded-lg bg-slate-50 text-slate-700 font-medium border border-slate-200 hover:bg-slate-100 transition"
          >
            🔄 月付机场
          </a>
          <a
            href="/clash-airports/"
            class="px-3 py-1.5 rounded-lg bg-slate-50 text-slate-700 font-medium border border-slate-200 hover:bg-slate-100 transition"
          >
            ⚡ Clash 机场
          </a>
          <a
            href="/chatgpt-airports/"
            class="px-3 py-1.5 rounded-lg bg-slate-50 text-slate-700 font-medium border border-slate-200 hover:bg-slate-100 transition"
          >
            🤖 ChatGPT 机场
          </a>
        </div>
      </div>
    </div>

    <!-- Article Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {allArticles.map((art) => (
        <article class="bg-white rounded-xl border border-slate-200/90 shadow-sm hover:shadow-md hover:border-sky-300 transition-all duration-200 p-5 flex flex-col justify-between group">
          <div>
            <div class="flex items-center gap-2 mb-3">
              <span class="badge-tag badge-brand text-[11px]">
                {art.categoryLabel}
              </span>
              <span class="text-xs text-slate-400 font-medium">{art.readTime}</span>
            </div>

            <h2 class="text-base font-bold text-slate-900 group-hover:text-sky-600 transition mb-2 leading-snug">
              <a href={`/blog/${art.slug}/`}>
                {art.title}
              </a>
            </h2>

            <p class="text-xs text-slate-600 line-clamp-3 leading-relaxed mb-4">
              {art.description}
            </p>
          </div>

          <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
            <span>{art.publishDate}</span>
            <a
              href={`/blog/${art.slug}/`}
              class="text-sky-600 font-semibold group-hover:underline flex items-center gap-1"
            >
              阅读指南
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>
