---
import { getAirportsForGaming, getAirportsByAIService, getAirportsByStreamingService, type Airport } from '../data/airports';
import AirportCard from './AirportCard.astro';

export interface Props {
  airports: Airport[];
  initialCategory?: string;
}

const { airports, initialCategory = '' } = Astro.props;

const gamingSlugs = new Set(getAirportsForGaming().map((a) => a.slug));
const chatgptSlugs = new Set(getAirportsByAIService('chatgpt').map((a) => a.slug));
const netflixSlugs = new Set(getAirportsByStreamingService('netflix').map((a) => a.slug));
---

<div id="airport-filter-root" class="space-y-6" data-initial-category={initialCategory}>
  <!-- Filter Control Panel -->
  <div class="bg-white rounded-xl border border-slate-200/90 shadow-sm p-5 space-y-4">
    <!-- Top Search & Sort Bar -->
    <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-3 pb-4 border-b border-slate-100">
      <!-- Search input -->
      <div class="relative flex-1">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input
          type="text"
          id="filter-search-input"
          placeholder="搜索机场名称、协议、地区、解锁支持..."
          class="w-full pl-9 pr-4 py-2 text-sm bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-sky-500 focus:bg-white transition"
        />
      </div>

      <!-- Sorting & Counter -->
      <div class="flex items-center justify-between md:justify-end gap-3">
        <div class="text-xs text-slate-500">
          已找到 <span id="filtered-count" class="font-bold text-sky-600">{airports.length}</span> 家机场
        </div>

        <div class="flex items-center gap-2">
          <label for="sort-select" class="text-xs text-slate-500 shrink-0">排序:</label>
          <select
            id="sort-select"
            class="text-xs font-medium text-slate-700 bg-slate-50 border border-slate-200 rounded-lg px-2.5 py-1.5 focus:outline-none focus:ring-2 focus:ring-sky-500"
          >
            <option value="default">默认顺序</option>
            <option value="price-asc">价格从低到高</option>
            <option value="price-desc">价格从高到低</option>
          </select>

          <button
            type="button"
            id="reset-filter-btn"
            class="text-xs text-slate-500 hover:text-rose-600 px-2 py-1 rounded hover:bg-slate-100 transition hidden"
          >
            重置筛选
          </button>
        </div>
      </div>
    </div>

    <!-- Filter Buttons Groups -->
    <div class="space-y-3.5 text-xs">
      <!-- 价格区间 -->
      <div class="flex flex-col sm:flex-row sm:items-center gap-2">
        <span class="font-semibold text-slate-600 w-16 shrink-0">价格区间:</span>
        <div class="flex items-center gap-1.5 flex-wrap filter-group" data-filter-type="price">
          <button type="button" data-value="all" class="filter-btn active">全部</button>
          <button type="button" data-value="0-10" class="filter-btn">≤ ¥10/月</button>
          <button type="button" data-value="10-20" class="filter-btn">¥10 - ¥20</button>
          <button type="button" data-value="20-30" class="filter-btn">¥20 - ¥30</button>
          <button type="button" data-value="30-50" class="filter-btn">¥30 - ¥50</button>
          <button type="button" data-value="50+" class="filter-btn">¥50 以上</button>
        </div>
      </div>

      <!-- 节点地区 -->
      <div class="flex flex-col sm:flex-row sm:items-center gap-2">
        <span class="font-semibold text-slate-600 w-16 shrink-0">节点地区:</span>
        <div class="flex items-center gap-1.5 flex-wrap filter-group" data-filter-type="region">
          <button type="button" data-value="all" class="filter-btn active">全部</button>
          <button type="button" data-value="香港" class="filter-btn">香港节点</button>
          <button type="button" data-value="日本" class="filter-btn">日本节点</button>
          <button type="button" data-value="新加坡" class="filter-btn">新加坡节点</button>
          <button type="button" data-value="美国" class="filter-btn">美国节点</button>
          <button type="button" data-value="台湾" class="filter-btn">台湾节点</button>
          <button type="button" data-value="韩国" class="filter-btn">韩国节点</button>
          <button type="button" data-value="英国" class="filter-btn">欧洲节点</button>
        </div>
      </div>

      <!-- 解锁与用途 -->
      <div class="flex flex-col sm:flex-row sm:items-center gap-2">
        <span class="font-semibold text-slate-600 w-16 shrink-0">核心用途:</span>
        <div class="flex items-center gap-1.5 flex-wrap filter-group" data-filter-type="purpose">
          <button type="button" data-value="all" class="filter-btn active">全部</button>
          <button type="button" data-value="chatgpt" class="filter-btn">ChatGPT / AI</button>
          <button type="button" data-value="netflix" class="filter-btn">Netflix / 流媒体</button>
          <button type="button" data-value="gaming" class="filter-btn">游戏加速专线</button>
          <button type="button" data-value="onetime" class="filter-btn">不限时流量包</button>
        </div>
      </div>

      <!-- 支持客户端 -->
      <div class="flex flex-col sm:flex-row sm:items-center gap-2">
        <span class="font-semibold text-slate-600 w-16 shrink-0">客户端:</span>
        <div class="flex items-center gap-1.5 flex-wrap filter-group" data-filter-type="client">
          <button type="button" data-value="all" class="filter-btn active">全部</button>
          <button type="button" data-value="clash" class="filter-btn">Clash</button>
          <button type="button" data-value="shadowrocket" class="filter-btn">Shadowrocket</button>
          <button type="button" data-value="sing-box" class="filter-btn">sing-box</button>
          <button type="button" data-value="surge" class="filter-btn">Surge</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Airport Grid Container -->
  <div id="airport-card-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
    {airports.map((airport) => (
      <div
        class="airport-item-wrapper"
        data-id={airport.id}
        data-name={airport.name.toLowerCase()}
        data-aliases={(airport.aliases || '').toLowerCase()}
        data-slug={airport.slug}
        data-price={airport.lowestMonthlyPrice ?? 999}
        data-annual={airport.lowestAnnualPrice ?? 9999}
        data-onetime={airport.lowestOneTimePrice ?? 0}
        data-regions={airport.regions.join(',')}
        data-protocols={airport.protocols.toLowerCase()}
        data-line={airport.lineArchitecture.toLowerCase()}
        data-ai={airport.aiServices.join(',').toLowerCase()}
        data-streaming={airport.streamingServices.join(',').toLowerCase()}
        data-clients={airport.clients.join(',').toLowerCase()}
        data-summary={airport.summary.toLowerCase()}
        data-gaming={gamingSlugs.has(airport.slug) ? 'true' : 'false'}
        data-chatgpt={chatgptSlugs.has(airport.slug) ? 'true' : 'false'}
        data-netflix={netflixSlugs.has(airport.slug) ? 'true' : 'false'}
      >
        <AirportCard airport={airport} />
      </div>
    ))}
  </div>

  <!-- Empty State -->
  <div id="no-results-box" class="hidden text-center py-16 bg-white rounded-xl border border-dashed border-slate-300 p-8">
    <div class="w-12 h-12 rounded-full bg-slate-100 text-slate-400 mx-auto flex items-center justify-center mb-3">
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    </div>
    <h4 class="text-base font-bold text-slate-800 mb-1">未找到符合条件的机场</h4>
    <p class="text-xs text-slate-500 mb-4">您可以尝试放宽价格区间或切换其他地区与用途分类。</p>
    <button
      type="button"
      id="empty-reset-btn"
      class="px-4 py-2 text-xs font-semibold text-white bg-sky-600 hover:bg-sky-700 rounded-lg shadow-sm transition"
    >
      清空所有筛选条件
    </button>
  </div>
</div>

<style>
  .filter-btn {
    padding: 0.35rem 0.65rem;
    border-radius: 0.375rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: #475569;
    background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    transition: all 0.15s ease-in-out;
  }
  .filter-btn:hover {
    color: #0284c7;
    background-color: #f0f9ff;
    border-color: #bae6fd;
  }
  .filter-btn.active {
    color: #ffffff;
    background-color: #0284c7;
    border-color: #0284c7;
    font-weight: 600;
    box-shadow: 0 1px 2px rgba(2, 132, 199, 0.2);
  }
</style>

<script>
  function initFilter() {
    const root = document.getElementById('airport-filter-root');
    if (!root) return;

    const searchInput = document.getElementById('filter-search-input') as HTMLInputElement | null;
    const sortSelect = document.getElementById('sort-select') as HTMLSelectElement | null;
    const resetBtn = document.getElementById('reset-filter-btn') as HTMLButtonElement | null;
    const emptyResetBtn = document.getElementById('empty-reset-btn') as HTMLButtonElement | null;
    const countDisplay = document.getElementById('filtered-count');
    const grid = document.getElementById('airport-card-grid');
    const noResults = document.getElementById('no-results-box');
    const items = Array.from(document.querySelectorAll('.airport-item-wrapper')) as HTMLElement[];

    const activeFilters = {
      search: '',
      price: 'all',
      region: 'all',
      purpose: 'all',
      client: 'all',
      sort: 'default'
    };

    // Parse URL params or initial category if present
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.has('price')) activeFilters.price = urlParams.get('price') || 'all';
    if (urlParams.has('region')) activeFilters.region = urlParams.get('region') || 'all';
    if (urlParams.has('purpose')) activeFilters.purpose = urlParams.get('purpose') || 'all';
    if (urlParams.has('client')) activeFilters.client = urlParams.get('client') || 'all';
    if (urlParams.has('q')) {
      activeFilters.search = urlParams.get('q') || '';
      if (searchInput) searchInput.value = activeFilters.search;
    }

    // Set active button states
    Object.entries(activeFilters).forEach(([type, val]) => {
      if (type === 'search' || type === 'sort') return;
      const group = document.querySelector(`.filter-group[data-filter-type="${type}"]`);
      if (group) {
        group.querySelectorAll('.filter-btn').forEach(btn => {
          if ((btn as HTMLElement).dataset.value === val) {
            btn.classList.add('active');
          } else {
            btn.classList.remove('active');
          }
        });
      }
    });

    function applyFilter() {
      let visibleCount = 0;
      const query = activeFilters.search.toLowerCase().trim();

      items.forEach(item => {
        const name = item.dataset.name || '';
        const aliases = item.dataset.aliases || '';
        const summary = item.dataset.summary || '';
        const protocols = item.dataset.protocols || '';
        const line = item.dataset.line || '';
        const regions = item.dataset.regions || '';
        const ai = item.dataset.ai || '';
        const streaming = item.dataset.streaming || '';
        const clients = item.dataset.clients || '';
        const price = parseFloat(item.dataset.price || '999');
        const onetime = parseFloat(item.dataset.onetime || '0');

        let matchesSearch = true;
        if (query) {
          const fullText = `${name} ${aliases} ${summary} ${protocols} ${line} ${regions} ${ai} ${streaming} ${clients}`;
          matchesSearch = fullText.includes(query);
        }

        let matchesPrice = true;
        if (activeFilters.price === '0-10') {
          matchesPrice = price <= 10;
        } else if (activeFilters.price === '10-20') {
          matchesPrice = price > 10 && price <= 20;
        } else if (activeFilters.price === '20-30') {
          matchesPrice = price > 20 && price <= 30;
        } else if (activeFilters.price === '30-50') {
          matchesPrice = price > 30 && price <= 50;
        } else if (activeFilters.price === '50+') {
          matchesPrice = price > 50;
        }

        let matchesRegion = true;
        if (activeFilters.region !== 'all') {
          matchesRegion = regions.includes(activeFilters.region);
        }

        let matchesPurpose = true;
        if (activeFilters.purpose === 'chatgpt') {
          matchesPurpose = item.dataset.chatgpt === 'true';
        } else if (activeFilters.purpose === 'netflix') {
          matchesPurpose = item.dataset.netflix === 'true';
        } else if (activeFilters.purpose === 'gaming') {
          matchesPurpose = item.dataset.gaming === 'true';
        } else if (activeFilters.purpose === 'onetime') {
          matchesPurpose = onetime > 0;
        }

        let matchesClient = true;
        if (activeFilters.client !== 'all') {
          matchesClient = clients.includes(activeFilters.client) || summary.includes(activeFilters.client);
        }

        if (matchesSearch && matchesPrice && matchesRegion && matchesPurpose && matchesClient) {
          item.style.display = '';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      // Sort items
      if (grid) {
        const sorted = items.slice().sort((a, b) => {
          const priceA = parseFloat(a.dataset.price || '999');
          const priceB = parseFloat(b.dataset.price || '999');
          if (activeFilters.sort === 'price-asc') return priceA - priceB;
          if (activeFilters.sort === 'price-desc') return priceB - priceA;
          return 0; // default original
        });
        sorted.forEach(el => grid.appendChild(el));
      }

      if (countDisplay) countDisplay.textContent = visibleCount.toString();

      if (noResults && grid) {
        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
          grid.classList.add('hidden');
        } else {
          noResults.classList.add('hidden');
          grid.classList.remove('hidden');
        }
      }

      // Show/hide reset button
      const isFiltered = query !== '' || activeFilters.price !== 'all' || activeFilters.region !== 'all' || activeFilters.purpose !== 'all' || activeFilters.client !== 'all';
      if (resetBtn) {
        if (isFiltered) {
          resetBtn.classList.remove('hidden');
        } else {
          resetBtn.classList.add('hidden');
        }
      }
    }

    // Event listeners
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        activeFilters.search = (e.target as HTMLInputElement).value;
        applyFilter();
      });
    }

    if (sortSelect) {
      sortSelect.addEventListener('change', (e) => {
        activeFilters.sort = (e.target as HTMLSelectElement).value;
        applyFilter();
      });
    }

    document.querySelectorAll('.filter-group').forEach(group => {
      const type = (group as HTMLElement).dataset.filterType as keyof typeof activeFilters;
      group.querySelectorAll('.filter-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          group.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          const val = (btn as HTMLElement).dataset.value || 'all';
          (activeFilters as any)[type] = val;
          applyFilter();
        });
      });
    });

    function resetAll() {
      activeFilters.search = '';
      activeFilters.price = 'all';
      activeFilters.region = 'all';
      activeFilters.purpose = 'all';
      activeFilters.client = 'all';
      activeFilters.sort = 'default';

      if (searchInput) searchInput.value = '';
      if (sortSelect) sortSelect.value = 'default';

      document.querySelectorAll('.filter-group').forEach(group => {
        group.querySelectorAll('.filter-btn').forEach(b => {
          if ((b as HTMLElement).dataset.value === 'all') {
            b.classList.add('active');
          } else {
            b.classList.remove('active');
          }
        });
      });

      applyFilter();
    }

    if (resetBtn) resetBtn.addEventListener('click', resetAll);
    if (emptyResetBtn) emptyResetBtn.addEventListener('click', resetAll);

    applyFilter();
  }

  document.addEventListener('DOMContentLoaded', initFilter);
</script>
