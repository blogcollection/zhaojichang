---
export interface BreadcrumbItem {
  label: string;
  href?: string;
}

export interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;

// Build JSON-LD BreadcrumbList Schema
const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: '首页',
      item: 'https://zhaojichang.cyou/'
    },
    ...items.map((it, idx) => ({
      '@type': 'ListItem',
      position: idx + 2,
      name: it.label,
      ...(it.href ? { item: `https://zhaojichang.cyou${it.href}` } : {})
    }))
  ]
};
---

<nav aria-label="面包屑导航" class="py-3 text-xs text-slate-500 flex items-center gap-1.5 flex-wrap">
  <a href="/" class="hover:text-sky-600 transition flex items-center gap-1">
    <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
    </svg>
    首页
  </a>

  {items.map((item) => (
    <>
      <span class="text-slate-300">/</span>
      {item.href ? (
        <a href={item.href} class="hover:text-sky-600 transition">
          {item.label}
        </a>
      ) : (
        <span class="text-slate-800 font-medium truncate max-w-[200px] sm:max-w-xs">
          {item.label}
        </span>
      )}
    </>
  ))}
</nav>

<script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
